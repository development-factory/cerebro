@page
@using Cerebro.Enum
@model Cerebro.Pages.CatalogItems.CreateModel

@{
    ViewData["Title"] = "Create Product or Service";
}

<div class="row border border-2 p-3">
    <h1>Create product or service</h1>
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CatalogItem.Name" class="control-label"></label>
                <input asp-for="CatalogItem.Name" class="form-control" />
                <span asp-validation-for="CatalogItem.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CatalogItem.Type" class="control-label"></label>
                <select asp-for="CatalogItem.Type" class="form-control" asp-items="Html.GetEnumSelectList<CatalogItemType>()"></select>
                <span asp-validation-for="CatalogItem.Type" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CatalogItem.DefaultUnitPrice" class="control-label"></label>
                <input asp-for="CatalogItem.DefaultUnitPrice" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="CatalogItem.DefaultUnitPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CatalogItem.Description" class="control-label"></label>
                <textarea asp-for="CatalogItem.Description" class="form-control"></textarea>
                <span asp-validation-for="CatalogItem.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary mt-3" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
